# Провайдер LLM: anthropic (по умолчанию) | openai (любой OpenAI-совместимый API) | mock (заглушка без сети, только для проверки интерфейса)
LLM_PROVIDER=anthropic
# Ключ API провайдера. Только на сервере, никогда не коммитить.
LLM_API_KEY=
# Модель (необязательно). По умолчанию: claude-sonnet-5-5 для anthropic, gpt-4o-mini для openai
LLM_MODEL=
# Модель только для итоговой оценки (необязательно), например более быстрая
LLM_EVAL_MODEL=
# Свой адрес API (необязательно), например для OpenAI-совместимого прокси
LLM_BASE_URL=
